// Wifi
#define IOT_CONFIG_WIFI_SSID              "<WiFi-SSID>"
#define IOT_CONFIG_WIFI_PASSWORD          "<WiFi-Password>"

// === Device Selection ===
// Uncomment ONE of the following to select the active device:
// #define DEVICE_HYD_BALCONY_1
// #define DEVICE_HYD_BALCONY_2
// #define DEVICE_TEST

// Azure IoT Central
#define DPS_ID_SCOPE                      "<Scope-Id of iot central app>"

#ifdef DEVICE_HYD_BALCONY_1
  #define IOT_CONFIG_DEVICE_ID            "<Device-Id-1>"
  #ifndef IOT_CONFIG_USE_X509_CERT
    #define IOT_CONFIG_DEVICE_KEY          "<Device-Key-1>"
  #endif
#elif defined(DEVICE_HYD_BALCONY_2)
  #define IOT_CONFIG_DEVICE_ID            "<Device-Id-2>"
  #ifndef IOT_CONFIG_USE_X509_CERT
    #define IOT_CONFIG_DEVICE_KEY          "<Device-Key-2>"
  #endif
#elif defined(DEVICE_TEST)
  #define IOT_CONFIG_DEVICE_ID            "<Device-Id-Test>"
  #ifndef IOT_CONFIG_USE_X509_CERT
    #define IOT_CONFIG_DEVICE_KEY          "<Device-Key-Test>"
  #endif
#else
  #error "No device selected! Uncomment one of DEVICE_HYD_BALCONY_1, DEVICE_HYD_BALCONY_2, or DEVICE_TEST"
#endif


// User-agent (url-encoded) provided by the MQTT client to Azure IoT Services.
// When developing for your own Arduino-based platform,
// please update the suffix with the format '(ard;<platform>)' as an url-encoded string.
#define AZURE_SDK_CLIENT_USER_AGENT       "c%2F" AZ_SDK_VERSION_STRING "(ard%3Besp32)"

// Publish 1 message in time interval of TELEMETRY_FREQUENCY_IN_SECONDS seconds
#ifdef DEVICE_TEST
  #define TELEMETRY_FREQUENCY_IN_SECONDS   5 // 5 seconds - for testing purposes
#else
  #define TELEMETRY_FREQUENCY_IN_SECONDS   30 * 60 // 30 minutes in seconds - for production  
#endif

// For how long the MQTT password (SAS token) is valid, in minutes.
// After that, the sample automatically generates a new password and re-connects.
#define MQTT_PASSWORD_LIFETIME_IN_MINUTES 60

#define WIFI_CONNECTION_TIMEOUT_IN_SECONDS 60

